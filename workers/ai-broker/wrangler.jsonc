{
  // The AI broker (see worker.js). One container (2 vCPU, 6 GiB, below): one `codex exec` at a time uses well under 1 GiB (measured 28 Oct 2026, throwaway check: codex 0.162.1 runs as uid 1001); ~185 MiB a running call, 0.53 GiB idle (11 Nov 2026), which sets worker.js PARALLEL. max_instances 1 = ONE login, ONE refresher.
  // Secret: BROKER_ADMIN_TOKEN (wrangler secret put; Keychain jobadabra.codex-broker.admin_token), only for the owner's one-time login upload.
  // Why (1 Nov 2026, owner: rename to ai-broker): this is the FINAL state after the Durable Object namespace moved here from the Worker `jobadabra-codex-broker` (which stays as a forwarder). Never deploy it before the transfer
  // has run (done 1 Nov 2026, its folder removed 2 Nov): a plain deploy of a new Worker name starts an EMPTY namespace and the Codex login is gone (seen on the throwaway proof, 1 Nov 2026). release-ai-broker.yml refuses unless /health says ready.
  "name": "jobadabra-ai-broker",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {"enabled": true},
  // Why (31 Oct 2026, owner: '$2/day'; paid Claude API removed 3 Nov 2026, owner: no API keys): Free AI is the only engine with a UTC-day cap; the two subscriptions have their own allowances.
  "vars": {"AUDIENCE": "jobadabra-ai-broker", "REPOSITORY": "GarryOne/jobadabra,GarryOne/jobadabra-web,GarryOne/jobadabra-lab,jobadabra/jobadabra,jobadabra/jobadabra-web,jobadabra/jobadabra-lab,jobadabra/jobadabra-benchmarks", "FALLBACK_FREE_AI_DAY_USD": "2", "ENGINE": "codex", "ENGINE_ADAPT": "on"},
  // Container application name `ai-broker` (not derived from the class), so the later class rename does not create a new application (proven 1 Nov 2026).
  // Why (11 Nov 2026, as; owner asked via AskUserQuestion: "Yes, bigger container (Recommended)", about +$3-6 a month): on `basic` (1/4 vCPU) a small Codex call took 10.6 s, 6.0 s of it
  // Codex starting up, and start-up grew with the calls running at once: 1.7 s alone, 3.2 s at 2, 6.6 s at 4, 8.5 s at 8, while the model's own turn stayed near 3.5 s (452 calls, the per-call
  // timeline in this Worker's log, 10-11 Nov 22:15-01:15 UTC). 1 vCPU is the smallest custom size; 3 GiB is its minimum memory. CPU is billed by use, memory while the container is awake.
  // Why (11 Nov 2026, as; owner asked via AskUserQuestion, with the numbers "about +$6 to +$19 a month for 2 vCPU / 6 GiB... arithmetic on Cloudflare's listed rates... not a quote": "2 vCPU / 6 GiB, then measure 6 at once"; "Expected: all 18 in about 23 minutes; must be measured after the resize"):
  // 1 vCPU was the limit, not the 8 slots (CPU 0.99 in the busiest minutes at 2-3 people, web#558; start-up 1.7 s alone, 8.5 s at 8 calls). 2 vCPU needs at least 6 GiB (Cloudflare: 3 GiB a vCPU minimum). Memory is billed while awake ($0.009 a GiB-hour), CPU by use,
  // so the extra is about +$0.027 an awake hour. max_instances stays 1 (one login, one refresher; several containers = untested two-refreshers design). PARALLEL is 12 since 12 Nov 2026 (worker.js says why): memory would allow far more, CPU (now 2) is what is unmeasured at more than 12.
  "containers": [
    {"name": "ai-broker", "image": "./container/Dockerfile", "image_build_context": ".", "instance_type": {"vcpu": 2, "memory_mib": 6144, "disk_mb": 4000}, "max_instances": 1}
  ],
  // Why (12 Nov 2026, owner: "this one I think should be on engineering"): the broker's notes go to the site's switchboard (POST /ops/notify on the `www` Worker), which picks the channel and the owner's switch; no Telegram secret lives here.
  // Secret: SELFHEAL_PUBLISH_KEY (the key every CI upload uses; Bearer for /ops/notify; a Worker secret does not move with the namespace). Without it, or without this binding, a note is not sent.
  "services": [{"binding": "SITE", "service": "www"}],
  "ai": {"binding": "AI"},
  "durable_objects": {"bindings": [{"name": "BROKER", "class_name": "CodexBroker"}]},
  "exports": {"CodexBroker": {"type": "durable-object", "storage": "sqlite", "container": "ai-broker"}}
}
