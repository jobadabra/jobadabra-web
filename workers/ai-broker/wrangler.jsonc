{
  // The AI broker (see worker.js). One container (4 vCPU, 6 GiB, set by lib/do-container.mjs on the durable_object policy since 13 Nov 2026; before it 2 vCPU on the Container class): one `codex exec` at a time uses well under 1 GiB (measured 28 Oct 2026, throwaway check: codex 0.162.1 runs as uid 1001); ~185 MiB a running call, 0.53 GiB idle (11 Nov 2026), which sets worker.js PARALLEL. One broker object (the front Worker names "broker") = ONE login, ONE refresher.
  // Secret: BROKER_ADMIN_TOKEN (wrangler secret put; Keychain jobadabra.codex-broker.admin_token), only for the owner's one-time login upload.
  // Why (1 Nov 2026, owner: rename to ai-broker): this is the FINAL state after the Durable Object namespace moved here from the Worker `jobadabra-codex-broker` (which stays as a forwarder). Never deploy it before the transfer
  // has run (done 1 Nov 2026, its folder removed 2 Nov): a plain deploy of a new Worker name starts an EMPTY namespace and the Codex login is gone (seen on the throwaway proof, 1 Nov 2026). release-ai-broker.yml refuses unless /health says ready.
  "name": "jobadabra-ai-broker",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // Why (13 Nov 2026, owner: "That means we can lose jobs in the find jobs"): request.signal tells the broker when a CI caller gave up on a waiting call, so the wait alert counts it (lib/waiting.mjs); the default from 17 Nov 2026 dates.
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "observability": {"enabled": true},
  // Why (31 Oct 2026, owner: '$2/day'; paid Claude API removed 3 Nov 2026, owner: no API keys): Free AI is the only engine with a UTC-day cap; the two subscriptions have their own allowances.
  "vars": {"AUDIENCE": "jobadabra-ai-broker", "REPOSITORY": "GarryOne/jobadabra,GarryOne/jobadabra-web,GarryOne/jobadabra-lab,jobadabra/jobadabra,jobadabra/jobadabra-web,jobadabra/jobadabra-lab,jobadabra/jobadabra-benchmarks", "FALLBACK_FREE_AI_DAY_USD": "2", "ENGINE": "codex", "ENGINE_ADAPT": "on"},
  "containers": [
    // Why (13 Nov 2026, owner: "then, explore and try" the custom instance types; "Measure, then migrate (Recommended)"): the durable_object policy, whose size AiBroker sets when it starts
    // the container (4 vCPU / 6 GiB, lib/do-container.mjs; the Container class needed 12 GiB for 4 vCPU). It has no max_instances: one container per AiBroker object, and the front Worker names one.
    // The old application `ai-broker` (2 vCPU, Container class) left this list in plan 2/2; removing it here does not delete it on Cloudflare (deleted by hand after the deploy).
    {"name": "ai-broker-next", "class_name": "AiBroker", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile", "build_context": "."}}}
  ],
  // Why (12 Nov 2026, owner: "this one I think should be on engineering"): the broker's notes go to the site's switchboard (POST /ops/notify on the `www` Worker), which picks the channel and the owner's switch; no Telegram secret lives here.
  // Secret: SELFHEAL_PUBLISH_KEY (the key every CI upload uses; Bearer for /ops/notify; a Worker secret does not move with the namespace). Without it, or without this binding, a note is not sent.
  "services": [{"binding": "SITE", "service": "www"}],
  "ai": {"binding": "AI"},
  "durable_objects": {"bindings": [{"name": "BROKER", "class_name": "AiBroker"}]},
  // Why (13 Nov 2026, plan 2/2; owner via sa: "if it is clean, ship 2/2"): CodexBroker's namespace is deleted with its storage (the copy taken at the switch, 13 Nov 01:44Z, is AiBroker's);
  // a deleted tombstone stays until a deploy reports it stale (Cloudflare: Durable Object class exports), then it may go.
  "exports": {"CodexBroker": {"type": "durable-object", "state": "deleted"}, "AiBroker": {"type": "durable-object", "storage": "sqlite"}}
}
